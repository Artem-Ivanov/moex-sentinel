APPLICATION_ENVIRONMENT=TEST
BROKER_ACCESS_MODE=READ_ONLY
# Daily PROD admission preparation is opt-in; empty canary accepts baseline only.
DAILY_ADMISSION_PREPARATION_ENABLED=false
INTERNAL_WORKER_ID=
INTERNAL_WORKER_BROKER_ID=
INTERNAL_WORKER_TOKEN=
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTH_SESSION_COOKIE_NAME=__Host-moex-session
AUTH_ALLOWED_ORIGIN=https://135.136.178.252
APP_PORT=8080
AUTH_USERNAME=operator
# Generate with: uv run python -m moex_sentinel.api.auth hash-password
AUTH_PASSWORD_HASH=replace-with-generated-scrypt-verifier
# Set true only for local HTTP through 127.0.0.1; remote Compose forces false.
AUTH_INSECURE_LOOPBACK=false
POSTGRES_PORT=55432
POSTGRES_DB=moex_sentinel
POSTGRES_USER=moex_sentinel
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_VOLUME_NAME=moex-sentinel-postgres-data
AUTOMATON_VOLUME_NAME=moex-sentinel_automaton-data
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
FACT_OUTBOX_BATCH_SIZE=100
FACT_OUTBOX_DEADLINE_MS=1000
# Retries after the initial attempt; delays 1/3/5/7/9 seconds. 0 disables retries.
SANDBOX_RETRY_LIMIT=5
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=60
PORTFOLIO_SNAPSHOT_ALL_ENVIRONMENTS=false
PORTFOLIO_SNAPSHOT_RETRY_LIMIT=3
PORTFOLIO_SNAPSHOT_RETRY_BASE_SECONDS=1
DAILY_ADMISSION_CHECK_INTERVAL_SECONDS=60
DAILY_ADMISSION_ATTEMPT_TIMEOUT_SECONDS=30
DAILY_ADMISSION_RETRY_DELAYS_SECONDS=[60,120,300]
READINESS_ALERT_POLL_INTERVAL_SECONDS=10
READINESS_ALERT_STARTUP_GRACE_SECONDS=60
READINESS_ALERT_HEARTBEAT_CONFIRMATION_SECONDS=30
READINESS_ALERT_CONTROL_CONFIRMATION_SECONDS=30
READINESS_ALERT_OUTBOX_CONFIRMATION_SECONDS=60
READINESS_ALERT_RETRY_DELAYS_SECONDS=[30,60,300]
READINESS_ALERT_QUEUE_LIMIT=16
TELEGRAM_REQUEST_TIMEOUT_SECONDS=5
MARKET_RECOVERY_RETRY_BASE_SECONDS=1
MARKET_RECOVERY_PROBE_INTERVAL_SECONDS=60
MARKET_OPERATION_TIMEOUT_SECONDS=10
MARKET_CLOSE_TIMEOUT_SECONDS=5
MARKET_QUIET_SECONDS=30
MARKET_TRADING_STATUS_TTL_SECONDS=30
MARKET_CANDLES_REFRESH_SECONDS=60
ANALYTICS_VERSION_HTTP_TIMEOUT_SECONDS=1
STRATEGY_BUY_ORDER_LOTS=1
STRATEGY_STOP_LOSS_PERCENT=5
STRATEGY_TAKE_PROFIT_PERCENT=6
STRATEGY_AVERAGING_STEP_PERCENT=0.5
STRATEGY_PARTIAL_TAKE_PROFIT_PERCENT=0.5
STRATEGY_PARTIAL_SELL_PERCENT=25
STRATEGY_MAX_PARTIAL_SELL_STEPS=3
STRATEGY_ORDER_TTL_SECONDS=10
STRATEGY_ORDER_RETRY_LIMIT=3
STRATEGY_CORE_RETRY_LIMIT=5
STRATEGY_ENABLED=false
DATABASE_URL=postgresql+psycopg://moex_sentinel:replace-with-local-password@127.0.0.1:55432/moex_sentinel
LOG_LEVEL=INFO
LOG_FORMAT=json
ANALYTICS_CORE_URL=http://backend:8000
ANALYTICS_CORE_HTTP_TIMEOUT_SECONDS=2
AUTOMATON_ITERATION_SECONDS=1
AUTOMATON_HEARTBEAT_INTERVAL_SECONDS=3
AUTOMATON_CORE_HTTP_TIMEOUT_SECONDS=10
AUTOMATON_ANALYTICS_HTTP_TIMEOUT_SECONDS=1
AUTOMATON_BROKER_RECOVERY_PROBE_SECONDS=60
AUTOMATON_ACCOUNT_SNAPSHOT_TTL_SECONDS=60
BROKER_REQUEST_TIMEOUT_SECONDS=10
AUTOMATON_WORKER_ID=
AUTOMATON_DATABASE_URL=sqlite:////app/data/trading_automaton.db
CORE_URL=http://backend:8000
ANALYTICS_URL=http://analytics:8001
CORE_ANALYTICS_URL=http://analytics:8001
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

# Core market version observation; leave this unset to use the local Compose service.
