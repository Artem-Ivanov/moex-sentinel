# Copy to deploy/remote/.env, chmod 600. Never commit the populated file.
# Use a unique stable name on the destination host.
COMPOSE_PROJECT_NAME=moex-sentinel-remote
RELEASE_TAG=replace-with-reviewed-git-commit
POSTGRES_DB=moex_sentinel
POSTGRES_USER=sentinel
# URL-safe random secret: openssl rand -hex 32. Do not reuse the example.
POSTGRES_PASSWORD=replace-with-random-hex-secret
POSTGRES_VOLUME_NAME=moex-sentinel-remote-postgres-data
AUTOMATON_VOLUME_NAME=moex-sentinel-remote-automaton-data
APP_PORT=8080
PORTFOLIO_SNAPSHOT_INTERVAL_SECONDS=60
# Transfer the exact current strategy values before migrating existing trading.
# This flag is not a substitute for stopping the Worker during backup/cutover.
STRATEGY_ENABLED=true
STRATEGY_BUY_ORDER_LOTS=1
STRATEGY_STOP_LOSS_PERCENT=5
STRATEGY_TAKE_PROFIT_PERCENT=6
STRATEGY_AVERAGING_STEP_PERCENT=0.5
STRATEGY_PARTIAL_TAKE_PROFIT_PERCENT=0.5
STRATEGY_PARTIAL_SELL_PERCENT=25
STRATEGY_MAX_PARTIAL_SELL_STEPS=3
STRATEGY_ORDER_TTL_SECONDS=10
STRATEGY_ORDER_RETRY_LIMIT=3
STRATEGY_CORE_RETRY_LIMIT=5
SANDBOX_RETRY_LIMIT=5
